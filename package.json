{
    "name": "comment-hider",
    "displayName": "Comment Hider",
    "description": "Toggle-hide or permanently remove comments in any file with one shortcut.",
    "version": "1.0.0",
    "publisher": "YuviSingh",
    "icon": "icon.png",
    "categories": ["Other"],
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./extension.js",
    "activationEvents": ["onStartupFinished"],
    "contributes": {
        "commands": [
            {
                "command": "commentHider.toggle",
                "title": "Toggle Hide Comments",
                "icon": "$(eye-closed)"
            },
            {
                "command": "commentHider.removeAll",
                "title": "Remove All Comments (Permanent)",
                "icon": "$(trash)"
            }
        ],
        "keybindings": [
            {
                "command": "commentHider.toggle",
                "key": "ctrl+f1",
                "mac": "cmd+f1",
                "when": "editorTextFocus"
            },
            {
                "command": "commentHider.removeAll",
                "key": "ctrl+f2",
                "mac": "cmd+f2",
                "when": "editorTextFocus"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "commentHider.toggle",
                    "group": "navigation@1"
                },
                {
                    "command": "commentHider.removeAll",
                    "group": "navigation@2"
                }
            ]
        }
    }
}