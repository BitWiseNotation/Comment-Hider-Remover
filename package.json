{
    "name": "comment-hider",
    "version": "1.0.0",
    "engines": {
        "vscode": "^1.80.0"
    },
    "main": "./extension.js",
    "activationEvents": ["onStartupFinished"],
    "contributes": {
        "commands": [
            {
                "command": "commentHider.toggle",
                "title": "Toggle Hide Comments"
            },
            {
                "command": "commentHider.removeAll",
                "title": "Remove All Comments (Permanent)"
            }
        ],
        "keybindings": [
            {
                "command": "commentHider.toggle",
                "key": "ctrl+f1",
                "mac": "cmd+f1",
                "when": "editorTextFocus"
            },
            {
                "command": "commentHider.removeAll",
                "key": "ctrl+f2",
                "mac": "cmd+f2",
                "when": "editorTextFocus"
            }
        ]
    }
}
